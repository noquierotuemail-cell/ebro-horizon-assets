{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ebro-remoteapp-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "CHATKIT_BACKEND_TOKEN"
    ]
  },
  "vars": {
    "CHATKIT_BACKEND_URL": "https://ebro-horizon-assets.onrender.com/chatkit",
    "CHATKIT_DOMAIN_KEY": "domain_pk_6a8168a3f250819492ae3c9a4df255c400ee8b3e878e05df"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "habroremote.com",
      "custom_domain": true
    }
  ]
}
