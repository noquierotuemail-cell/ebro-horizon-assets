{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ebro-remoteapp-landing",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "CHATKIT_BACKEND_TOKEN"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "habroremote.com",
      "custom_domain": true
    }
  ]
}
