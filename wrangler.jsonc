{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ebro-remoteapp-landing",
  "main": "src/router-20260827-v2.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "CHATKIT_BACKEND_TOKEN"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HABRO_METRICS",
        "class_name": "HabroMetrics"
      }
    ]
  },
  "migrations": [
    {
      "tag": "habro-analytics-v1",
      "new_sqlite_classes": ["HabroMetrics"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "DESAY_HELPERS",
      "bucket_name": "habro-desay-helpers"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "habroremote.com",
      "custom_domain": true
    }
  ]
}
